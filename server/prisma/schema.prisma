generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Player {
  puuid         String   @id @db.VarChar(78)
  gameName      String
  tagLine       String
  profileIconId Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participations MatchParticipant[]
  rankSnapshots  RankSnapshot[]
}

model Champion {
  id   Int    @id
  key  String @unique
  name String

  participations    MatchParticipant[]
  scoreboardEntries ScoreboardEntry[]
}

model Match {
  matchId      String   @id @db.VarChar(30)
  queueId      Int
  gameCreation DateTime
  gameDuration Int

  participants MatchParticipant[]
  scoreboard   ScoreboardEntry[]

  @@index([gameCreation])
}

model MatchParticipant {
  id           Int     @id @default(autoincrement())
  matchId      String  @db.VarChar(30)
  puuid        String  @db.VarChar(78)
  championId   Int
  teamPosition String
  win          Boolean
  kills        Int
  deaths       Int
  assists      Int
  cs           Int
  visionScore  Int

  match    Match    @relation(fields: [matchId], references: [matchId], onDelete: Cascade)
  player   Player   @relation(fields: [puuid], references: [puuid])
  champion Champion @relation(fields: [championId], references: [id])

  @@unique([matchId, puuid])
}

model ScoreboardEntry {
  id                Int     @id @default(autoincrement())
  matchId           String  @db.VarChar(30)
  puuid             String  @db.VarChar(78)
  gameName          String
  tagLine           String
  championId        Int
  teamId            Int
  teamPosition      String
  win               Boolean
  champLevel        Int
  kills             Int
  deaths            Int
  assists           Int
  cs                Int
  visionScore       Int
  goldEarned        Int
  damageToChampions Int

  match    Match    @relation(fields: [matchId], references: [matchId], onDelete: Cascade)
  champion Champion @relation(fields: [championId], references: [id])

  @@unique([matchId, puuid])
}

model RankSnapshot {
  id           Int      @id @default(autoincrement())
  puuid        String   @db.VarChar(78)
  queueType    String
  tier         String
  rank         String
  leaguePoints Int
  wins         Int
  losses       Int
  takenAt      DateTime @default(now())

  player Player @relation(fields: [puuid], references: [puuid])

  @@index([puuid, takenAt])
}
